rules_version = '2';

// Application documents are private: only the applicant and site admins can
// open them. Nothing else is stored.
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      let profile = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      return request.auth != null && profile.status == 'member' && profile.role == 'admin';
    }

    match /applications/{uid}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());

      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');

      allow delete: if request.auth != null && isAdmin();
    }
  }
}
